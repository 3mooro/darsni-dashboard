---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
let success = false;
let error = '';

if (Astro.request.method === 'POST') {
  try {
    const { env } = await import('cloudflare:workers');
    const db = env?.DB;
    if (db) {
      const data = await Astro.request.formData();
      const title = data.get('title') as string;
      let slugInput = data.get('slug') as string;
      const tags = data.get('tags') as string;
      const content = data.get('content') as string;
      
      const slug = slugInput ? slugInput.trim().replace(/\s+/g, '-') : title.trim().replace(/\s+/g, '-');
      const tagsJson = JSON.stringify(tags.split(',').map(t => t.trim()).filter(Boolean));
      
      let image = data.get('image') as string;
      if (!image || !image.startsWith('data:image')) {
        image = 'https://placehold.co/1200x630/9333ea/ffffff?text=' + encodeURIComponent(title);
      }
      
      await db.prepare(`
        INSERT INTO blog (slug, title, description, body, tags, heroImage, pubDate)
        VALUES (?, ?, ?, ?, ?, ?, date('now'))
      `).bind(slug, title, content.substring(0, 150).replace(/<[^>]+>/g, ''), content, tagsJson, image).run();
      
      success = true;
    } else {
      error = 'قاعدة البيانات غير متصلة';
    }
  } catch (e: any) {
    console.error(e);
    error = 'حدث خطأ: ' + e.message;
  }
}
---

<DashboardLayout title="إضافة مقال جديد - لوحة التحكم">
  <div class="flex flex-col gap-8 w-full max-w-4xl mx-auto">
    <!-- Header -->
    <div>
      <h1 class="text-3xl font-bold text-slate-900 dark:text-white font-cairo">إضافة مقال جديد</h1>
      <p class="text-slate-500 dark:text-slate-400 mt-1">اكتب مقالاً جديداً لمشاركته مع زوار المنصة والطلاب</p>
    </div>

    {success && (
      <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-xl relative" role="alert">
        <strong class="font-bold">نجاح!</strong>
        <span class="block sm:inline"> تم إضافة المقال بنجاح.</span>
      </div>
    )}
    {error && (
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-xl relative" role="alert">
        <strong class="font-bold">خطأ!</strong>
        <span class="block sm:inline"> {error}</span>
      </div>
    )}

    <!-- Form Container -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm p-6 sm:p-8">
      <form method="POST" class="flex flex-col gap-6" id="blog_form">
        <!-- Title Input -->
        <div class="flex flex-col gap-2">
          <label for="title" class="text-sm font-medium text-slate-700 dark:text-slate-300">عنوان المقال</label>
          <input type="text" id="title" name="title" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-3 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-purple-500/20 focus:border-purple-500 transition-all placeholder:text-slate-400" placeholder="اكتب عنواناً جذاباً لمقالك..." required>
        </div>

        <!-- Slug Input -->
        <div class="flex flex-col gap-2">
          <label for="slug" class="text-sm font-medium text-slate-700 dark:text-slate-300">الرابط المخصص للمقال (اختياري)</label>
          <input type="text" id="slug" name="slug" dir="ltr" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-3 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-purple-500/20 focus:border-purple-500 transition-all placeholder:text-slate-400" placeholder="مثال: how-to-learn-math (سيتم استخدام العنوان تلقائياً إذا تُرك فارغاً)">
        </div>

        <div class="flex flex-col gap-2">
          <label for="tags" class="text-sm font-medium text-slate-700 dark:text-slate-300">الكلمات المفتاحية (Tags)</label>
          <input type="text" id="tags" name="tags" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-3 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-purple-500/20 focus:border-purple-500 transition-all placeholder:text-slate-400" placeholder="مثال: برمجة, تعليم, تقنية (مفصولة بفاصلة)">
        </div>

        <!-- Image Upload -->
        <div class="flex flex-col gap-2">
          <label class="text-sm font-medium text-slate-700 dark:text-slate-300">صورة المقال الرئيسية</label>
          <div class="flex items-center gap-4">
            <img src="https://placehold.co/1200x630/9333ea/ffffff?text=Image" alt="Preview" class="w-32 h-20 rounded-xl object-cover border border-slate-200 dark:border-slate-700 hidden" id="image_preview" />
            <input type="file" id="image_upload" accept="image/*" class="text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-purple-50 file:text-purple-700 hover:file:bg-purple-100">
          </div>
          <input type="hidden" name="image" id="image_base64">
        </div>

        <!-- Rich Text Description (Quill) -->
        <div class="flex flex-col gap-2" dir="ltr">
          <div class="flex justify-end" dir="rtl">
            <label class="text-sm font-medium text-slate-700 dark:text-slate-300">محتوى المقال</label>
          </div>
          <div class="rounded-xl overflow-hidden border border-slate-200 dark:border-slate-700 focus-within:ring-2 focus-within:ring-purple-500/20 focus-within:border-purple-500 transition-all bg-slate-50 dark:bg-slate-800">
            <div id="blog-editor-container" class="h-96 text-slate-900 dark:text-white !border-none" dir="rtl"></div>
          </div>
          <input type="hidden" name="content" id="content_input">
        </div>

        <!-- Actions -->
        <div class="pt-4 flex justify-end gap-4 border-t border-slate-100 dark:border-slate-800 mt-2">
          <a href="/blog" class="px-6 py-3 rounded-xl font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">العودة</a>
          <button type="submit" class="bg-gradient-to-r from-purple-600 to-indigo-500 hover:from-purple-700 hover:to-indigo-600 text-white px-8 py-3 rounded-xl font-medium transition-all shadow-lg shadow-purple-500/25 hover:shadow-purple-500/40">
            نشر المقال
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Quill Styles & Script -->
  <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
  <style is:global>
    .ql-toolbar { border: none !important; border-bottom: 1px solid var(--fallback-bc, #e2e8f0) !important; background-color: transparent !important; border-radius: 0.75rem 0.75rem 0 0 !important; direction: ltr; text-align: left; }
    .dark .ql-toolbar { border-bottom-color: #334155 !important; }
    .ql-container { border: none !important; font-family: inherit !important; font-size: 1.05rem !important; line-height: 1.8 !important; }
    .dark .ql-editor.ql-blank::before { color: #94a3b8 !important; }
    .dark .ql-snow .ql-stroke { stroke: #cbd5e1 !important; }
    .dark .ql-snow .ql-fill, .dark .ql-snow .ql-stroke.ql-fill { fill: #cbd5e1 !important; }
    .dark .ql-snow .ql-picker { color: #cbd5e1 !important; }
  </style>
  <script is:inline src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
  <script is:inline>
    document.addEventListener("DOMContentLoaded", function() {
      var quill = new Quill('#blog-editor-container', {
        theme: 'snow',
        modules: {
          toolbar: [
            [{ 'header': [1, 2, 3, 4, 5, 6, false] }],
            [{ 'font': [] }],
            [{ 'size': ['small', false, 'large', 'huge'] }],
            ['bold', 'italic', 'underline', 'strike', 'blockquote'],
            [{ 'color': [] }, { 'background': [] }],
            [{ 'list': 'ordered'}, { 'list': 'bullet' }],
            [{ 'script': 'sub'}, { 'script': 'super' }],
            [{ 'indent': '-1'}, { 'indent': '+1' }],
            ['link', 'image', 'video'],
            [{ 'align': [] }],
            [{ 'direction': 'rtl' }],
            ['clean']
          ],
          clipboard: {
            matchVisual: false
          }
        },
        placeholder: 'ابدأ بكتابة مقالك الرائع هنا...'
      });
      
      quill.format('direction', 'rtl');
      quill.format('align', 'right');

      const fileInput = document.getElementById('image_upload');
      const imagePreview = document.getElementById('image_preview');
      const imageBase64 = document.getElementById('image_base64');

      fileInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file) return;
        
        const reader = new FileReader();
        reader.onload = function(event) {
          const img = new Image();
          img.onload = function() {
            const canvas = document.createElement('canvas');
            const MAX_WIDTH = 1200;
            const MAX_HEIGHT = 630;
            let width = img.width;
            let height = img.height;
            
            if (width > height) {
              if (width > MAX_WIDTH) { height *= MAX_WIDTH / width; width = MAX_WIDTH; }
            } else {
              if (height > MAX_HEIGHT) { width *= MAX_HEIGHT / height; height = MAX_HEIGHT; }
            }
            
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, width, height);
            
            const dataUrl = canvas.toDataURL('image/jpeg', 0.8);
            imagePreview.src = dataUrl;
            imagePreview.classList.remove('hidden');
            imageBase64.value = dataUrl;
          }
          img.src = event.target.result;
        }
        reader.readAsDataURL(file);
      });

      const form = document.querySelector('form');
      form.addEventListener('submit', function() {
        document.querySelector('#content_input').value = quill.root.innerHTML;
      });
    });
  </script>
</DashboardLayout>
