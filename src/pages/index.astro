---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { env } from 'cloudflare:workers';

let studentsCount = 0;
let newRequestsCount = 0;
let coursesCount = 0;
let blogCount = 0;
let recentRequests: any[] = [];

try {
  const db = env?.DB;
  if (db) {
    const studentsRes = await db.prepare("SELECT COUNT(*) as count FROM students").first();
    if (studentsRes) studentsCount = studentsRes.count as number;

    const newReqRes = await db.prepare("SELECT COUNT(*) as count FROM students WHERE status = 'جديد'").first();
    if (newReqRes) newRequestsCount = newReqRes.count as number;

    const coursesRes = await db.prepare("SELECT COUNT(*) as count FROM courses").first();
    if (coursesRes) coursesCount = coursesRes.count as number;

    const blogRes = await db.prepare("SELECT COUNT(*) as count FROM blog").first();
    if (blogRes) blogCount = blogRes.count as number;

    recentRequests = (await db.prepare("SELECT * FROM students ORDER BY id DESC LIMIT 5").all()).results;
  }
} catch (e) {
  console.error("DB error in dashboard index:", e);
}

const stats = [
  { label: 'إجمالي الطلاب والطلبات', value: studentsCount, icon: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2', color: 'bg-blue-500' },
  { label: 'طلبات جديدة', value: newRequestsCount, icon: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2', color: 'bg-emerald-500' },
  { label: 'الدورات المتاحة', value: coursesCount, icon: 'M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20', color: 'bg-purple-500' },
  { label: 'المقالات المنشورة', value: blogCount, icon: 'M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z', color: 'bg-rose-500' }
];
---

<DashboardLayout title="نظرة عامة">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    {stats.map(stat => (
      <div class="bg-white dark:bg-slate-900 rounded-2xl p-6 border border-slate-100 dark:border-slate-800 shadow-sm flex items-center gap-4">
        <div class={`w-14 h-14 rounded-xl flex items-center justify-center text-white ${stat.color} shadow-lg shadow-[${stat.color}]/30`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d={stat.icon}/>
            {stat.icon.includes('circle') && <circle cx="9" cy="7" r="4"/>}
            {stat.icon.includes('M2 3h6') && <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>}
            {stat.icon.includes('M23 6l-') && <polyline points="23 6 23 11 18 6"/>}
          </svg>
        </div>
        <div>
          <p class="text-slate-500 dark:text-slate-400 text-sm font-semibold">{stat.label}</p>
          <p class="text-3xl font-black text-slate-800 dark:text-white mt-1">{stat.value}</p>
        </div>
      </div>
    ))}
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 border border-slate-100 dark:border-slate-800 shadow-sm">
      <h3 class="text-lg font-bold mb-6 flex items-center justify-between">
        <span>أحدث طلبات التسجيل</span>
        <a href="/students" class="text-sm text-purple-600 hover:text-purple-700 font-semibold">عرض الكل</a>
      </h3>
      {recentRequests.length === 0 ? (
        <div class="text-center py-12 text-slate-500">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 mx-auto mb-4 text-slate-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <p>لا توجد طلبات جديدة حتى الآن</p>
        </div>
      ) : (
        <div class="space-y-4">
          {recentRequests.map(req => (
            <div class="flex items-center justify-between p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/50">
              <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-full bg-slate-200 dark:bg-slate-700 flex items-center justify-center font-bold text-slate-500 dark:text-slate-400">
                  {req.customer_name ? req.customer_name.substring(0, 1) : 'م'}
                </div>
                <div>
                  <h4 class="font-bold">{req.customer_name || 'مجهول'}</h4>
                  <p class="text-sm text-slate-500" dir="ltr">{req.phone}</p>
                </div>
              </div>
              <div class="text-left">
                <span class={`inline-block px-3 py-1 rounded-full text-xs font-semibold ${
                  req.status === 'جديد' ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400' :
                  'bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300'
                }`}>
                  {req.status}
                </span>
                <p class="text-xs text-slate-500 mt-1">{req.course_requested || 'غير محدد'}</p>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
    
    <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 border border-slate-100 dark:border-slate-800 shadow-sm">
      <h3 class="text-lg font-bold mb-4">اختصارات سريعة</h3>
      <div class="grid grid-cols-2 gap-4">
        <a href="/courses/add" class="flex flex-col items-center justify-center gap-3 p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/50 hover:bg-purple-50 dark:hover:bg-purple-900/20 text-slate-600 dark:text-slate-300 hover:text-purple-600 dark:hover:text-purple-400 transition-colors border border-transparent hover:border-purple-100 dark:hover:border-purple-800">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
          <span class="font-semibold">إضافة دورة</span>
        </a>
        <a href="/blog/add" class="flex flex-col items-center justify-center gap-3 p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/50 hover:bg-rose-50 dark:hover:bg-rose-900/20 text-slate-600 dark:text-slate-300 hover:text-rose-600 dark:hover:text-rose-400 transition-colors border border-transparent hover:border-rose-100 dark:hover:border-rose-800">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
          <span class="font-semibold">مقال جديد</span>
        </a>
      </div>
    </div>
  </div>
</DashboardLayout>
