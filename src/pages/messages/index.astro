---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

let messages: any[] = [];
let error = '';

try {
  const { env } = await import('cloudflare:workers');
  const db = env?.DB;
  if (db) {
    if (Astro.request.method === 'POST') {
      const data = await Astro.request.formData();
      const action = data.get('action');
      const msgId = data.get('message_id');
      
      if (action === 'delete' && msgId) {
        await db.prepare('DELETE FROM messages WHERE id = ?').bind(msgId).run();
      }
    }

    const { results } = await db.prepare(`
      SELECT * FROM messages ORDER BY created_at DESC
    `).all();
    messages = results || [];
  }
} catch (e: any) {
  console.error(e);
}
---

<DashboardLayout title="الرسائل والاستفسارات - لوحة التحكم">
  <div class="flex flex-col gap-8 w-full max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-3xl font-bold text-slate-900 dark:text-white font-cairo">الرسائل والاستفسارات</h1>
        <p class="text-slate-500 dark:text-slate-400 mt-1">عرض الرسائل المرسلة من صفحة اتصل بنا</p>
      </div>
    </div>

    <!-- Table Section -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden">
      <div class="p-6 border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/20 flex justify-between items-center">
        <h2 class="text-lg font-semibold text-slate-800 dark:text-slate-200">صندوق الوارد</h2>
        <span class="bg-purple-100 text-purple-700 dark:bg-purple-500/20 dark:text-purple-400 px-3 py-1 rounded-full text-sm font-medium">{messages.length} رسالة</span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-right border-collapse">
          <thead>
            <tr class="bg-slate-50/50 dark:bg-slate-800/20 border-b border-slate-100 dark:border-slate-800">
              <th class="py-4 px-6 text-sm font-medium text-slate-500 dark:text-slate-400">الاسم</th>
              <th class="py-4 px-6 text-sm font-medium text-slate-500 dark:text-slate-400">رقم الهاتف</th>
              <th class="py-4 px-6 text-sm font-medium text-slate-500 dark:text-slate-400">البرنامج المطلوب</th>
              <th class="py-4 px-6 text-sm font-medium text-slate-500 dark:text-slate-400 w-1/3">الرسالة</th>
              <th class="py-4 px-6 text-sm font-medium text-slate-500 dark:text-slate-400">التاريخ</th>
              <th class="py-4 px-6 text-sm font-medium text-slate-500 dark:text-slate-400">إجراءات</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            {messages.map((msg) => (
              <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors">
                <td class="py-4 px-6 font-semibold text-slate-900 dark:text-white">{msg.name}</td>
                <td class="py-4 px-6 text-slate-600 dark:text-slate-300 font-medium font-sans" dir="ltr" style="text-align: right;">{msg.phone}</td>
                <td class="py-4 px-6 text-slate-600 dark:text-slate-300">
                  {msg.course === 'math' ? 'الرياضيات' : msg.course === 'physics' ? 'الفيزياء' : msg.course === 'english' ? 'اللغة الإنجليزية' : msg.course === 'other' ? 'أخرى' : msg.course}
                </td>
                <td class="py-4 px-6 text-slate-600 dark:text-slate-300 whitespace-pre-wrap">{msg.message}</td>
                <td class="py-4 px-6 text-slate-600 dark:text-slate-300">
                  {msg.created_at ? new Date(msg.created_at).toLocaleDateString('ar-EG', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'غير متوفر'}
                </td>
                <td class="py-4 px-6">
                  <form method="POST">
                    <input type="hidden" name="action" value="delete" />
                    <input type="hidden" name="message_id" value={msg.id} />
                    <button type="submit" class="text-rose-500 hover:text-rose-600 font-bold text-sm bg-rose-50 dark:bg-rose-900/20 px-3 py-1.5 rounded-lg transition-colors border border-rose-200 dark:border-rose-800/50 shadow-sm" onclick="return confirm('هل أنت متأكد من حذف هذه الرسالة؟');">
                      حذف
                    </button>
                  </form>
                </td>
              </tr>
            ))}
            {messages.length === 0 && (
              <tr>
                <td colspan="6" class="py-12 text-center text-slate-500 dark:text-slate-400">لا يوجد رسائل حالياً.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</DashboardLayout>
