---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
let students = [];
let message = '';
let error = '';

try {
  const { env } = await import('cloudflare:workers');
  const db = env?.DB;
  if (db) {
    if (Astro.request.method === 'POST') {
      const data = await Astro.request.formData();
      const action = data.get('action');
      const studentId = data.get('student_id');
      
      if (action === 'approve' && studentId) {
        await db.prepare("UPDATE enrollments SET status = 'تمت الموافقة' WHERE id = ?").bind(studentId).run();
        message = 'تمت الموافقة على الطلب بنجاح!';
      } else if (action === 'reject' && studentId) {
        await db.prepare("UPDATE enrollments SET status = 'مرفوض' WHERE id = ?").bind(studentId).run();
        message = 'تم رفض الطلب.';
      }
    }

    const { results } = await db.prepare(`
      SELECT e.*, u.name as customer_name, u.phone as phone, c.title as course_requested 
      FROM enrollments e
      LEFT JOIN users u ON e.user_id = u.id
      LEFT JOIN courses c ON e.course_id = c.id
      ORDER BY e.created_at DESC
    `).all();
    students = results || [];
  } else {
    error = 'قاعدة البيانات غير متصلة.';
  }
} catch (e) {
  console.error(e);
  error = 'حدث خطأ أثناء الاتصال بقاعدة البيانات.';
}
---

<DashboardLayout title="طلبات الكورسات والطلاب - لوحة التحكم">
  <div class="flex flex-col gap-8 w-full max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-3xl font-bold text-slate-900 dark:text-white font-cairo">إدارة طلبات الطلاب</h1>
        <p class="text-slate-500 dark:text-slate-400 mt-1">عرض طلبات حجز الكورسات والموافقة عليها</p>
      </div>
      <div class="relative w-full sm:w-auto">
        <input type="text" placeholder="البحث عن طالب أو هاتف..." class="w-full sm:w-80 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl px-5 py-3 pr-12 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-purple-500/20 focus:border-purple-500 transition-all shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 absolute right-4 top-1/2 -translate-y-1/2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </div>
    </div>

    {message && (
      <div class="p-4 bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400 rounded-xl font-bold border border-green-200 dark:border-green-800 shadow-sm">
        {message}
      </div>
    )}
    
    {error && (
      <div class="p-4 bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400 rounded-xl font-bold border border-red-200 dark:border-red-800 shadow-sm">
        {error}
      </div>
    )}

    <!-- Table Section -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden">
      <div class="p-6 border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/20 flex justify-between items-center">
        <h2 class="text-lg font-semibold text-slate-800 dark:text-slate-200">الطلبات المسجلة</h2>
        <span class="bg-purple-100 text-purple-700 dark:bg-purple-500/20 dark:text-purple-400 px-3 py-1 rounded-full text-sm font-medium">{students.length} طلب</span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-right border-collapse">
          <thead>
            <tr class="bg-slate-50/50 dark:bg-slate-800/20 border-b border-slate-100 dark:border-slate-800">
              <th class="py-4 px-6 text-sm font-medium text-slate-500 dark:text-slate-400">اسم الطالب</th>
              <th class="py-4 px-6 text-sm font-medium text-slate-500 dark:text-slate-400">رقم الهاتف</th>
              <th class="py-4 px-6 text-sm font-medium text-slate-500 dark:text-slate-400">الكورس المطلوب</th>
              <th class="py-4 px-6 text-sm font-medium text-slate-500 dark:text-slate-400">تاريخ الطلب</th>
              <th class="py-4 px-6 text-sm font-medium text-slate-500 dark:text-slate-400">الحالة</th>
              <th class="py-4 px-6 text-sm font-medium text-slate-500 dark:text-slate-400">إجراءات</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            {students.map((student) => (
              <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors group">
                <td class="py-4 px-6">
                  <div class="flex items-center gap-3">
                    <div class="h-10 w-10 rounded-full bg-gradient-to-tr from-purple-500 to-indigo-500 flex items-center justify-center text-white font-bold shadow-md">
                      {(student.customer_name || 'ط').charAt(0)}
                    </div>
                    <div class="font-semibold text-slate-900 dark:text-white">{student.customer_name || 'غير متوفر'}</div>
                  </div>
                </td>
                <td class="py-4 px-6 text-slate-600 dark:text-slate-300 font-medium font-sans" dir="ltr" style="text-align: right;">{student.phone}</td>
                <td class="py-4 px-6 text-slate-600 dark:text-slate-300 font-medium">{student.course_requested}</td>
                <td class="py-4 px-6 text-slate-600 dark:text-slate-300">
                  {new Date(student.created_at).toLocaleDateString('ar-EG', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}
                </td>
                <td class="py-4 px-6">
                  <span class={`inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium 
                    ${student.status === 'تمت الموافقة' ? 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400' : 
                      student.status === 'مرفوض' ? 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400' : 
                      'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400'}`}>
                    {student.status === 'pending' ? 'جديد' : (student.status || 'جديد')}
                  </span>
                </td>
                <td class="py-4 px-6">
                  <div class="flex gap-2">
                    {student.status !== 'تمت الموافقة' && (
                      <form method="POST">
                        <input type="hidden" name="action" value="approve" />
                        <input type="hidden" name="student_id" value={student.id} />
                        <button type="submit" class="text-green-600 hover:text-green-700 font-bold text-sm bg-green-50 dark:bg-green-900/20 px-3 py-1.5 rounded-lg transition-colors border border-green-200 dark:border-green-800/50 shadow-sm" title="موافقة">
                          موافقة
                        </button>
                      </form>
                    )}
                    {student.status !== 'مرفوض' && (
                      <form method="POST">
                        <input type="hidden" name="action" value="reject" />
                        <input type="hidden" name="student_id" value={student.id} />
                        <button type="submit" class="text-red-600 hover:text-red-700 font-bold text-sm bg-red-50 dark:bg-red-900/20 px-3 py-1.5 rounded-lg transition-colors border border-red-200 dark:border-red-800/50 shadow-sm" title="رفض">
                          رفض
                        </button>
                      </form>
                    )}
                  </div>
                </td>
              </tr>
            ))}
            {students.length === 0 && (
              <tr>
                <td colspan="6" class="py-12 text-center text-slate-500 dark:text-slate-400">لا يوجد طلبات كورسات حالياً.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</DashboardLayout>
