---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
let students = [];
let message = '';
let error = '';

try {
  const { env } = await import('cloudflare:workers');
  const db = env?.DB;
  if (db) {
    if (Astro.request.method === 'POST') {
      const data = await Astro.request.formData();
      const action = data.get('action');
      const userId = data.get('user_id');
      
      if (action === 'reset_password' && userId) {
        await db.prepare('UPDATE users SET password = ? WHERE id = ?').bind('12345678', userId).run();
        message = 'تم إعادة تعيين كلمة المرور إلى 12345678 بنجاح!';
      }
    }

    const { results } = await db.prepare(`
      SELECT u.*, COUNT(e.id) as enrolled_courses 
      FROM users u 
      LEFT JOIN enrollments e ON u.id = e.user_id 
      WHERE u.role = 'student' 
      GROUP BY u.id 
      ORDER BY u.created_at DESC
    `).all();
    students = results || [];
  }
} catch (e: any) {
  console.error(e);
  // error = 'لا يوجد جدول users في قاعدة البيانات أو لم يتم توصيلها.';
}
---

<DashboardLayout title="الطلاب المسجلين - لوحة التحكم">
  <div class="flex flex-col gap-8 w-full max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-3xl font-bold text-slate-900 dark:text-white font-cairo">الطلاب المسجلين</h1>
        <p class="text-slate-500 dark:text-slate-400 mt-1">عرض حسابات الطلاب المسجلين بالمنصة (لديهم حساب دخول)</p>
      </div>
      <div class="relative w-full sm:w-auto">
        <input type="text" placeholder="البحث عن طالب..." class="w-full sm:w-80 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl px-5 py-3 pr-12 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-purple-500/20 focus:border-purple-500 transition-all shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 absolute right-4 top-1/2 -translate-y-1/2 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </div>
    </div>

    {message && (
      <div class="p-4 bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400 rounded-xl font-bold border border-green-200 dark:border-green-800 shadow-sm">
        {message}
      </div>
    )}
    
    {error && (
      <div class="p-4 bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400 rounded-xl font-bold border border-red-200 dark:border-red-800 shadow-sm">
        {error}
      </div>
    )}

    <!-- Table Section -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden">
      <div class="p-6 border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/20 flex justify-between items-center">
        <h2 class="text-lg font-semibold text-slate-800 dark:text-slate-200">قائمة الحسابات</h2>
        <span class="bg-purple-100 text-purple-700 dark:bg-purple-500/20 dark:text-purple-400 px-3 py-1 rounded-full text-sm font-medium">{students.length} طالب</span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-right border-collapse">
          <thead>
            <tr class="bg-slate-50/50 dark:bg-slate-800/20 border-b border-slate-100 dark:border-slate-800">
              <th class="py-4 px-6 text-sm font-medium text-slate-500 dark:text-slate-400">اسم الطالب</th>
              <th class="py-4 px-6 text-sm font-medium text-slate-500 dark:text-slate-400">البريد الإلكتروني</th>
              <th class="py-4 px-6 text-sm font-medium text-slate-500 dark:text-slate-400">رقم الهاتف</th>
              <th class="py-4 px-6 text-sm font-medium text-slate-500 dark:text-slate-400">الدورات المسجلة</th>
              <th class="py-4 px-6 text-sm font-medium text-slate-500 dark:text-slate-400">تاريخ الانضمام</th>
              <th class="py-4 px-6 text-sm font-medium text-slate-500 dark:text-slate-400">إجراءات</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            {students.map((student) => (
              <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors">
                <td class="py-4 px-6">
                  <div class="flex items-center gap-3">
                    <div class="h-10 w-10 rounded-full bg-gradient-to-tr from-purple-500 to-indigo-500 flex items-center justify-center text-white font-bold shadow-md">
                      {(student.name || 'ط').charAt(0)}
                    </div>
                    <div class="font-semibold text-slate-900 dark:text-white">{student.name || 'غير متوفر'}</div>
                  </div>
                </td>
                <td class="py-4 px-6 text-slate-600 dark:text-slate-300 font-medium font-sans" dir="ltr" style="text-align: right;">{student.email}</td>
                <td class="py-4 px-6" dir="ltr" style="text-align: right;">
                  {student.phone ? (
                    <a href={`https://wa.me/${student.phone.replace(/[^0-9]/g, '')}`} target="_blank" class="inline-flex items-center gap-1.5 text-green-700 dark:text-green-400 font-bold font-sans hover:underline" title="مراسلة عبر واتساب">
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                      {student.phone}
                    </a>
                  ) : (
                    <span class="text-slate-400 dark:text-slate-600 text-sm">غير متوفر</span>
                  )}
                </td>
                <td class="py-4 px-6">
                  <span class="inline-flex items-center justify-center h-8 w-8 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold text-sm">
                    {student.enrolled_courses || 0}
                  </span>
                </td>
                <td class="py-4 px-6 text-slate-600 dark:text-slate-300">
                  {student.created_at ? new Date(student.created_at).toLocaleDateString('ar-EG') : 'غير متوفر'}
                </td>
                <td class="py-4 px-6">
                  <form method="POST">
                    <input type="hidden" name="action" value="reset_password" />
                    <input type="hidden" name="user_id" value={student.id} />
                    <button type="submit" class="text-rose-500 hover:text-rose-600 font-bold text-sm bg-rose-50 dark:bg-rose-900/20 px-3 py-1.5 rounded-lg transition-colors border border-rose-200 dark:border-rose-800/50 shadow-sm" onclick="return confirm('هل أنت متأكد من إعادة تعيين كلمة المرور إلى 12345678 ؟');">
                      إعادة تعيين المرور
                    </button>
                  </form>
                </td>
              </tr>
            ))}
            {students.length === 0 && (
              <tr>
                <td colspan="6" class="py-12 text-center text-slate-500 dark:text-slate-400">لا يوجد طلاب مسجلين حالياً.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</DashboardLayout>
