---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
let success = false;
let error = '';

if (Astro.request.method === 'POST') {
  try {
    const { env } = await import('cloudflare:workers');
    const db = env?.DB;
    if (db) {
      const data = await Astro.request.formData();
      const name = data.get('name') as string;
      const phone = data.get('phone') as string;
      const session_price = parseFloat(data.get('session_price') as string);

      await db.prepare(`
        INSERT INTO teachers (name, phone, session_price, sessions_count, created_at)
        VALUES (?, ?, ?, 0, CURRENT_TIMESTAMP)
      `).bind(name, phone, session_price).run();
      
      success = true;
    } else {
      error = 'قاعدة البيانات غير متصلة';
    }
  } catch (e: any) {
    console.error(e);
    error = 'حدث خطأ: ' + e.message;
  }
}
---

<DashboardLayout title="إضافة معلم جديد - لوحة التحكم">
  <div class="flex flex-col gap-8 w-full max-w-3xl mx-auto">
    <!-- Header -->
    <div>
      <h1 class="text-3xl font-bold text-slate-900 dark:text-white font-cairo">إضافة معلم جديد</h1>
      <p class="text-slate-500 dark:text-slate-400 mt-1">تسجيل معلم جديد لحساب حصصه ومستحقاته المالية</p>
    </div>

    {success && (
      <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-xl relative" role="alert">
        <strong class="font-bold">نجاح!</strong>
        <span class="block sm:inline"> تم إضافة المعلم بنجاح.</span>
      </div>
    )}
    {error && (
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-xl relative" role="alert">
        <strong class="font-bold">خطأ!</strong>
        <span class="block sm:inline"> {error}</span>
      </div>
    )}

    <!-- Form Container -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm p-6 sm:p-8">
      <form method="POST" class="flex flex-col gap-6">
        
        <div class="flex flex-col gap-2">
          <label for="name" class="text-sm font-medium text-slate-700 dark:text-slate-300">اسم المعلم</label>
          <input type="text" id="name" name="name" required class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-3 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-purple-500/20 focus:border-purple-500 transition-all placeholder:text-slate-400" placeholder="اكتب اسم المعلم ثلاثياً...">
        </div>

        <div class="flex flex-col gap-2">
          <label for="phone" class="text-sm font-medium text-slate-700 dark:text-slate-300">رقم الهاتف (للتواصل)</label>
          <input type="text" id="phone" name="phone" dir="ltr" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-3 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-purple-500/20 focus:border-purple-500 transition-all placeholder:text-slate-400" placeholder="مثال: 966500000000">
        </div>

        <div class="flex flex-col gap-2">
          <label for="session_price" class="text-sm font-medium text-slate-700 dark:text-slate-300">ثمن الحصة الواحدة للمعلم (بالريال)</label>
          <input type="number" id="session_price" name="session_price" min="0" step="1" required class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-3 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-purple-500/20 focus:border-purple-500 transition-all placeholder:text-slate-400" placeholder="مثال: 50">
        </div>

        <!-- Actions -->
        <div class="pt-4 flex justify-end gap-4 border-t border-slate-100 dark:border-slate-800 mt-2">
          <a href="/teachers" class="px-6 py-3 rounded-xl font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">العودة</a>
          <button type="submit" class="bg-gradient-to-r from-purple-600 to-indigo-500 hover:from-purple-700 hover:to-indigo-600 text-white px-8 py-3 rounded-xl font-medium transition-all shadow-lg shadow-purple-500/25 hover:shadow-purple-500/40">
            تسجيل المعلم
          </button>
        </div>
      </form>
    </div>
  </div>
</DashboardLayout>
