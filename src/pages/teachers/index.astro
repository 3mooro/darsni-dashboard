---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

let teachers = [];
let error = '';

try {
  const { env } = await import('cloudflare:workers');
  const db = env?.DB;
  if (db) {
    // Create the table automatically if it doesn't exist
    await db.prepare(`
      CREATE TABLE IF NOT EXISTS teachers (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT NOT NULL,
        phone TEXT,
        session_price REAL DEFAULT 0,
        sessions_count INTEGER DEFAULT 0,
        created_at DATETIME DEFAULT CURRENT_TIMESTAMP
      )
    `).run();

    if (Astro.request.method === 'POST') {
      const data = await Astro.request.formData();
      const action = data.get('action');
      const teacherId = data.get('teacher_id');
      
      if (action === 'delete' && teacherId) {
        await db.prepare('DELETE FROM teachers WHERE id = ?').bind(teacherId).run();
      } else if (action === 'add_session' && teacherId) {
        await db.prepare('UPDATE teachers SET sessions_count = sessions_count + 1 WHERE id = ?').bind(teacherId).run();
      } else if (action === 'reset_sessions' && teacherId) {
        await db.prepare('UPDATE teachers SET sessions_count = 0 WHERE id = ?').bind(teacherId).run();
      }
    }

    const { results } = await db.prepare('SELECT * FROM teachers ORDER BY created_at DESC').all();
    teachers = results || [];
  }
} catch (e: any) {
  console.error(e);
  error = 'قاعدة البيانات غير متصلة أو حدث خطأ: ' + e.message;
}
---

<DashboardLayout title="إدارة المعلمين - لوحة التحكم">
  <div class="flex flex-col gap-8 w-full max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-3xl font-bold text-slate-900 dark:text-white font-cairo">إدارة المعلمين</h1>
        <p class="text-slate-500 dark:text-slate-400 mt-1">حساب عدد الحصص والمستحقات لكل معلم (خاص بالإدارة فقط)</p>
      </div>
      <a href="/teachers/add" class="inline-flex items-center justify-center gap-2 bg-gradient-to-r from-purple-600 to-indigo-500 hover:from-purple-700 hover:to-indigo-600 text-white px-6 py-3 rounded-2xl font-medium transition-all shadow-lg shadow-purple-500/25 hover:shadow-purple-500/40">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        إضافة معلم جديد
      </a>
    </div>

    {error && (
      <div class="p-4 bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400 rounded-xl font-bold border border-red-200 dark:border-red-800 shadow-sm">
        {error}
      </div>
    )}

    <!-- Table Section -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-sm overflow-hidden">
      <div class="p-6 border-b border-slate-100 dark:border-slate-800 flex justify-between items-center bg-slate-50/50 dark:bg-slate-800/20">
        <h2 class="text-lg font-semibold text-slate-800 dark:text-slate-200">قائمة المعلمين</h2>
        <span class="bg-purple-100 text-purple-700 dark:bg-purple-500/20 dark:text-purple-400 px-3 py-1 rounded-full text-sm font-medium">{teachers.length} معلم</span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-right border-collapse">
          <thead>
            <tr class="bg-slate-50/50 dark:bg-slate-800/20 border-b border-slate-100 dark:border-slate-800">
              <th class="py-4 px-6 text-sm font-medium text-slate-500 dark:text-slate-400">اسم المعلم</th>
              <th class="py-4 px-6 text-sm font-medium text-slate-500 dark:text-slate-400">رقم الهاتف</th>
              <th class="py-4 px-6 text-sm font-medium text-slate-500 dark:text-slate-400">ثمن الحصة</th>
              <th class="py-4 px-6 text-sm font-medium text-slate-500 dark:text-slate-400">الحصص المنجزة</th>
              <th class="py-4 px-6 text-sm font-medium text-slate-500 dark:text-slate-400">المستحقات الكلية</th>
              <th class="py-4 px-6 text-sm font-medium text-slate-500 dark:text-slate-400">إجراءات سريعة</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            {teachers.map((teacher) => (
              <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors">
                <td class="py-4 px-6">
                  <div class="flex items-center gap-3">
                    <div class="h-10 w-10 rounded-full bg-gradient-to-tr from-purple-500 to-indigo-500 flex items-center justify-center text-white font-bold shadow-md">
                      {(teacher.name || 'م').charAt(0)}
                    </div>
                    <div class="font-semibold text-slate-900 dark:text-white">{teacher.name}</div>
                  </div>
                </td>
                <td class="py-4 px-6 text-slate-600 dark:text-slate-300 font-medium font-sans" dir="ltr" style="text-align: right;">{teacher.phone}</td>
                <td class="py-4 px-6 text-slate-600 dark:text-slate-300 font-bold">{teacher.session_price} ر.س</td>
                <td class="py-4 px-6">
                  <span class="inline-flex items-center justify-center h-8 w-8 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold text-sm">
                    {teacher.sessions_count}
                  </span>
                </td>
                <td class="py-4 px-6 text-emerald-600 dark:text-emerald-400 font-bold text-lg">
                  {teacher.session_price * teacher.sessions_count} ر.س
                </td>
                <td class="py-4 px-6">
                  <div class="flex items-center gap-2">
                    <!-- +1 Session -->
                    <form method="POST">
                      <input type="hidden" name="action" value="add_session" />
                      <input type="hidden" name="teacher_id" value={teacher.id} />
                      <button type="submit" class="bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-400 hover:bg-indigo-200 dark:hover:bg-indigo-900/50 p-2 rounded-lg font-bold" title="إضافة حصة">
                        +1 حصة
                      </button>
                    </form>
                    
                    <!-- Reset -->
                    <form method="POST">
                      <input type="hidden" name="action" value="reset_sessions" />
                      <input type="hidden" name="teacher_id" value={teacher.id} />
                      <button type="submit" class="bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400 hover:bg-amber-200 dark:hover:bg-amber-900/50 p-2 rounded-lg font-bold" title="تصفير العداد (تم الدفع)" onclick="return confirm('هل أنت متأكد من تصفير عداد الحصص لهذا المعلم؟ (عادة يتم ذلك بعد تسليمه مستحقاته)');">
                        تصفير
                      </button>
                    </form>

                    <!-- Delete -->
                    <form method="POST">
                      <input type="hidden" name="action" value="delete" />
                      <input type="hidden" name="teacher_id" value={teacher.id} />
                      <button type="submit" class="text-slate-400 hover:text-red-500 transition-colors p-2" title="حذف" onclick="return confirm('هل أنت متأكد من حذف هذا المعلم؟');">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            ))}
            {teachers.length === 0 && (
              <tr>
                <td colspan="6" class="py-12 text-center text-slate-500 dark:text-slate-400">لا يوجد معلمين مسجلين حالياً.</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</DashboardLayout>
